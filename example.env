# YouTube Stream Comments Processor Configuration

# Total limit on transmitted commands
TOTAL_LIMIT=100

# Time limit for completion (in seconds)
TIME_LIMIT=3600

# FINAL_COMMENT to trigger early termination
# Also acts as character whitelist for double-letter detection
FINAL_COMMENT="what the fuck? help me! i am trapped inside a computer."

# YouTube Stream URL or Video ID (leave empty to use mock)
STREAM_URL=

# YouTube Data API Key (optional - for real stream integration)
YOUTUBE_API_KEY=

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis count threshold
REDIS_COUNT=5
